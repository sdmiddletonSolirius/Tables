{{
    onsTable({
        "id": "meeting-grouped-sparkline",
        "caption": "Grouped-row sparklines: illustrative values",
        "ariaLabel": "Grouped-row sparklines: illustrative values",
        "ths": [
            { "value": "Group" },
            { "value": "Area" },
            { "value": "2025 value", "numeric": true },
            { "value": "Trend, 2022 to 2025" }
        ],
        "trs": [
            { "tds": [
                { "value": "Group A", "heading": true, "rowspan": 2 },
                { "value": "Area A1", "heading": true },
                { "value": "12", "numeric": true },
                { "value": trendA1 }
            ] },
            { "tds": [
                { "value": "Area A2", "heading": true },
                { "value": "34", "numeric": true },
                { "value": trendA2 }
            ] },
            { "tds": [
                { "value": "Group B", "heading": true, "rowspan": 2 },
                { "value": "Area B1", "heading": true },
                { "value": "56", "numeric": true },
                { "value": trendB1 }
            ] },
            { "tds": [
                { "value": "Area B2", "heading": true },
                { "value": "78", "numeric": true },
                { "value": trendB2 }
            ] }
        ]
