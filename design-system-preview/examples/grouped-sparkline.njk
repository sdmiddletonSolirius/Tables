{% from "components/table/_macro.njk" import onsTable %}
{% from "examples/_sparkline.njk" import previewSparkline %}
{% set trendA1 %}
    {{ previewSparkline({
        "label": "Group A, Area A1 trend",
        "series": [
            { "label": "2022", "value": 8 },
            { "label": "2023", "value": 11 },
            { "label": "2024", "value": 9 },
            { "label": "2025", "value": 12 }
        ]
    }) }}
{% endset %}
{% set trendA2 %}
    {{ previewSparkline({
        "label": "Group A, Area A2 trend",
        "series": [
            { "label": "2022", "value": 40 },
            { "label": "2023", "value": 36 },
            { "label": "2024", "value": 38 },
            { "label": "2025", "value": 34 }
        ]
    }) }}
{% endset %}
{% set trendB1 %}
    {{ previewSparkline({
        "label": "Group B, Area B1 trend",
        "series": [
            { "label": "2022", "value": 50 },
            { "label": "2023", "value": 52 },
            { "label": "2024", "value": 51 },
            { "label": "2025", "value": 56 }
        ]
    }) }}
{% endset %}
{% set trendB2 %}
