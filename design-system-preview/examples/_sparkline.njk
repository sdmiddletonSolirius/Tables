{% macro previewSparkline(params) %}
    {% set chart = params | sparklineData %}
    <svg class="preview-sparkline" width="{{ chart.width }}" height="{{ chart.height }}" viewBox="0 0 {{ chart.width }} {{ chart.height }}" aria-hidden="true" focusable="false">
        <polyline points="{{ chart.points }}" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"></polyline>
    </svg>
    <span class="ons-u-vh">{{ chart.description }}</span>
{% endmacro %}
